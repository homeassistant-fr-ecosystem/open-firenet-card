    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "lit": "^3.1.4",
    "rollup": "^4.64.10",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
