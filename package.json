{
  "name": "open-firenet-card",
  "version": "0.1.0",
  "description": "Lovelace card for Open Firenet / RIKA pellet stoves (Home Assistant integration open-firenet-ha)",
  "type": "module",
  "module": "dist/open-firenet-card.js",
  "main": "dist/open-firenet-card.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openfirenet/open-firenet-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
