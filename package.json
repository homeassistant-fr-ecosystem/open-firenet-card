{
  "name": "open-firenet-card",
  "version": "0.1.0",
  "description": "Lovelace card for Open Firenet / RIKA pellet stoves (Home Assistant integration open-firenet-ha)",
  "type": "module",
  "module": "dist/open-firenet-card.js",
  "main": "dist/open-firenet-card.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openfirenet/open-firenet-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "open-firenet",
    "rika",
    "pellet-stove"
  ],
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint",
      "tsc --noEmit"
    ],
    "test/**/*.ts": [
      "eslint",
      "tsc --noEmit"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "lit": "^3.3.3",
    "playwright": "^1.53.0",
    "rollup": "^4.68.6",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.1"
  }
}
