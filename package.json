    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "happy-dom": "^14.12.3",
    "rollup": "^4.18.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
